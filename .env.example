# ─────────────────────────────────────────────────────────────────────────────
# DashGoBo - Example environment file.
# Copy to `.env` and fill values. NEVER commit `.env` with real secrets.
# Each app also has its own `.env.example` (apps/api, apps/web) for local runs
# outside Docker. This root file is what `docker compose` reads (Mailpit only —
# the database is Supabase, not a local container; see apps/api/.env.example).
# ─────────────────────────────────────────────────────────────────────────────

# --- General ---
NODE_ENV=development

# --- URLs ---
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# --- Ports (host) ---
WEB_PORT=3000
API_PORT=3001
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Database (Supabase project → Project Settings → Database → Connection string) ---
# DATABASE_URL: "Connection pooling" string (port 6543, add ?pgbouncer=true). Used at runtime.
# DIRECT_URL:   "Connection string" (port 5432, no pooling). Used by Prisma Migrate.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:YOUR-PASSWORD@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.xxxxxxxxxxxx:YOUR-PASSWORD@aws-0-xx-xxxx-1.pooler.supabase.com:5432/postgres

# --- Auth (generate strong random values, e.g. `openssl rand -base64 48`) ---
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# --- Encryption at rest for sensitive credentials (32-byte base64 key) ---
ENCRYPTION_KEY=change-me-32-byte-base64-key

# --- Pluggable providers (MVP defaults) ---
STORAGE_PROVIDER=local
EMAIL_PROVIDER=mailpit
INVOICE_PROVIDER=mock

# --- ARCA (not wired in MVP; placeholder only) ---
ARCA_ENVIRONMENT=homologation

# --- Frontend (exposed to the browser, must be non-secret) ---
NEXT_PUBLIC_API_URL=http://localhost:3001
