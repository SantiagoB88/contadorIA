# Base local SQLite (se crea en prisma/dev.db). Sin secretos.
DATABASE_URL="file:./dev.db"
# Modo de ejecución: DEMO | HOMOLOGACION | PRODUCCION. En esta versión solo existe DEMO.
APP_MODE="DEMO"
# Carpeta de archivos privados (documentos y adjuntos). Fuera de public/. Por defecto: ./storage
# STORAGE_DIR="./storage"

# ── Bot de WhatsApp (Meta Cloud API). Ver docs/whatsapp-prueba-real.md ──
# Sin estos valores el bot funciona igual en el simulador (/dev/whatsapp) y las respuestas
# que se manden por WhatsApp quedan "pendientes" (nunca se finge una entrega).
# WHATSAPP_TOKEN="token-de-ejemplo"
# WHATSAPP_PHONE_NUMBER_ID="123456789012345"
# WHATSAPP_VERIFY_TOKEN="un-texto-que-elijas-vos"
# WHATSAPP_APP_SECRET="app-secret-de-ejemplo"
# WHATSAPP_GRAPH_API_VERSION="v23.0"
# URL pública para los enlaces que manda el bot (si no, se usa la del pedido).
# APP_URL="https://tu-tunel.ejemplo.com"
