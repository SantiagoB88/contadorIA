# Copia de ejemplo SIN secretos. En el VPS el archivo real va en /etc/contadorsmart/contadorsmart.env
# con permisos 600 (solo root). Nunca subir el archivo real a GitHub ni pegarlo en un chat.

APP_MODE=DEMO
APP_URL=https://app.TUDOMINIO.com

# Primer arranque (base vacía): estudio y administrador del piloto.
PILOT_STUDY_NAME=Estudio Piloto
PILOT_ADMIN_NAME=Nombre Apellido
PILOT_ADMIN_EMAIL=contador@ejemplo.com
PILOT_ADMIN_PASSWORD=cambiar-por-una-larga-de-12-o-mas

# WhatsApp Cloud API (Meta → tu app → WhatsApp → Configuración de la API / Configuración básica).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=un-texto-que-elijas-vos
WHATSAPP_GRAPH_API_VERSION=v23.0

# Solo si en los registros aparece el error 131030 al responder a celulares argentinos (ver docs/despliegue-hostinger.md).
# WHATSAPP_AR_SIN_9=1
