// ContadorSmart · esquema mínimo del Paso 1 (versión simple, SQLite local).
// Convenciones:
//  - Importes en centavos (BigInt). Nunca se suma dinero con coma flotante.
//  - Fechas contables como texto "YYYY-MM-DD" (sin zona horaria). Eventos técnicos en DateTime (UTC).
//  - Los "enums" se guardan como String porque SQLite no los soporta; los valores válidos están en src/lib/constants.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Study {
  id             String            @id @default(cuid())
  name           String
  acceptsSignups Boolean           @default(false) // el registro público crea usuarios en este estudio
  createdAt      DateTime          @default(now())
  users          User[]
  taxpayers      Taxpayer[]
  invoices       Invoice[]
  auditEvents    AuditEvent[]
  accessRequests AccessRequest[]
  scaleVersions  TaxScaleVersion[]
}

model User {
  id               String           @id @default(cuid())
  studyId          String
  study            Study            @relation(fields: [studyId], references: [id])
  email            String           @unique
  name             String
  phone            String?
  passwordHash     String
  role             String // ADMIN | CLIENTE
  active           Boolean          @default(true)
  emailVerifiedAt  DateTime?
  createdAt        DateTime         @default(now())
  sessions         Session[]
  accesses         TaxpayerAccess[]
  authTokens       AuthToken[]
  accessRequests   AccessRequest[]  @relation("RequestUser")
  requestsCreated  ServiceRequest[] @relation("RequestCreator")
  requestsAssigned ServiceRequest[] @relation("RequestAssignee")
  requestMessages  RequestMessage[]
  documents        Document[]

  @@index([studyId])
}

// Tokens de un solo uso (verificación de correo y recuperación). Se guarda solo el hash.
model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // VERIFICAR_CORREO | RESTABLECER_CLAVE
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, type])
}

// Pedido de un usuario para asociarse a un CUIT. Declarar un CUIT no da acceso: lo aprueba el estudio.
model AccessRequest {
  id                String    @id @default(cuid())
  studyId           String
  study             Study     @relation(fields: [studyId], references: [id])
  userId            String
  user              User      @relation("RequestUser", fields: [userId], references: [id])
  cuit              String
  declaredName      String
  declaredActivity  String
  declaredCategory  String?
  declaredStartDate String // YYYY-MM-DD
  status            String // PENDIENTE | APROBADO | RECHAZADO
  reviewNote        String?
  reviewedById      String?
  reviewedAt        DateTime?
  taxpayerId        String?
  createdAt         DateTime  @default(now())

  @@index([studyId, status])
  @@index([userId])
}

// Correo capturado localmente: en DEMO no se envía nada, se guarda acá y se ve en /dev/correos.
model OutboxEmail {
  id        String   @id @default(cuid())
  to        String
  subject   String
  body      String
  createdAt DateTime @default(now())
}

// Marcas de actualización de datos ya aplicadas (ver prisma/upgrade.ts).
model AppMeta {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Taxpayer {
  id              String            @id @default(cuid())
  studyId         String
  study           Study             @relation(fields: [studyId], references: [id])
  cuit            String // normalizado, 11 dígitos sin guiones
  name            String
  activity        String
  regime          String            @default("MONOTRIBUTO")
  categoryCode    String? // categoría registrada (la carga el estudio)
  startDate       String // YYYY-MM-DD
  createdAt       DateTime          @default(now())
  accesses        TaxpayerAccess[]
  invoices        Invoice[]
  coverage        DataCoverage?
  categoryHistory CategoryHistory[]
  obligations     Obligation[]
  debtReview      DebtReview?
  serviceRequests ServiceRequest[]
  documents       Document[]

  @@unique([studyId, cuit])
}

model TaxpayerAccess {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  taxpayerId String
  taxpayer   Taxpayer @relation(fields: [taxpayerId], references: [id])
  status     String // APROBADO | REVOCADO
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@unique([userId, taxpayerId])
}

// Escala de categorías versionada, por estudio. La edita el estudio desde Backoffice → Escalas.
// DEMO = valores ficticios; VALIDADA exige fuente. Las vigencias de un mismo estudio no se superponen.
model TaxScaleVersion {
  id          String             @id @default(cuid())
  studyId     String? // null solo en bases anteriores a la entrega 4 (prisma/upgrade.ts lo completa)
  study       Study?             @relation(fields: [studyId], references: [id])
  name        String
  source      String
  status      String // DEMO | VALIDADA
  validFrom   String // YYYY-MM-DD
  validTo     String? // YYYY-MM-DD (null = sin fecha de fin)
  createdById String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @default(now()) @updatedAt
  limits      TaxCategoryLimit[]

  @@index([studyId, validFrom])
}

model TaxCategoryLimit {
  id               String          @id @default(cuid())
  scaleVersionId   String
  scaleVersion     TaxScaleVersion @relation(fields: [scaleVersionId], references: [id])
  code             String
  annualLimitCents BigInt

  @@unique([scaleVersionId, code])
}

// Historial de la categoría registrada. La carga el estudio; el sistema nunca la cambia solo.
model CategoryHistory {
  id          String   @id @default(cuid())
  taxpayerId  String
  taxpayer    Taxpayer @relation(fields: [taxpayerId], references: [id])
  code        String? // null = sin categoría
  validFrom   String // YYYY-MM-DD desde cuándo rige
  reason      String
  createdById String?
  createdAt   DateTime @default(now())

  @@index([taxpayerId, validFrom])
}

// Deudas y vencimientos cargados por el estudio (no hay consulta automática a ARCA).
model Obligation {
  id          String   @id @default(cuid())
  studyId     String
  taxpayerId  String
  taxpayer    Taxpayer @relation(fields: [taxpayerId], references: [id])
  concept     String
  period      String // YYYY-MM
  dueDate     String // YYYY-MM-DD
  amountCents BigInt? // null = importe no informado
  currency    String   @default("ARS")
  status      String // PENDIENTE | PAGO_INFORMADO | PAGO_VERIFICADO | ANULADA
  statusNote  String? // evidencia o comentario de la revisión
  source      String   @default("Cargado por el estudio")
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([taxpayerId, dueDate])
}

// Última revisión de deuda del contribuyente. Sin revisión, la deuda es "No disponible" (nunca "sin deuda").
model DebtReview {
  id           String   @id @default(cuid())
  taxpayerId   String   @unique
  taxpayer     Taxpayer @relation(fields: [taxpayerId], references: [id])
  asOfDate     String // YYYY-MM-DD: fecha a la que corresponde la información
  status       String // REVISADA | PENDIENTE_REVISION
  note         String?
  source       String   @default("Cargado por el estudio")
  reviewedById String?
  updatedAt    DateTime @default(now()) @updatedAt
}

// Comprobantes / movimientos de facturación.
model Invoice {
  id                    String            @id @default(cuid())
  studyId               String
  study                 Study             @relation(fields: [studyId], references: [id])
  taxpayerId            String
  taxpayer              Taxpayer          @relation(fields: [taxpayerId], references: [id])
  issueDate             String // YYYY-MM-DD
  recipientName         String
  description           String
  amountCents           BigInt // total; en el facturador lo calcula el servidor desde los ítems
  currency              String            @default("ARS")
  status                String // VERIFICADO | BORRADOR | EN_PROCESO | SIMULADO | RECHAZADO
  source                String // DATOS_FICTICIOS | CARGA_MANUAL | FACTURADOR
  environment           String            @default("DEMO")
  createdById           String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @default(now()) @updatedAt
  // Facturador: fotografía de los datos del receptor al momento del comprobante.
  recipientId           String?
  recipient             InvoiceRecipient? @relation(fields: [recipientId], references: [id])
  recipientDocType      String? // CUIT | DNI | SIN_IDENTIFICAR
  recipientDocNumber    String?
  recipientTaxCondition String? // CONSUMIDOR_FINAL | RESPONSABLE_INSCRIPTO | MONOTRIBUTO | EXENTO
  invoiceType           String? // C (monotributo)
  pointOfSale           Int?
  number                Int? // numeración interna de la simulación, no fiscal
  issuedAt              DateTime?
  rejectionReason       String?
  items                 InvoiceItem[]
  attempts              InvoiceAttempt[]

  @@index([taxpayerId, issueDate])
  @@index([taxpayerId, source, status])
}

// Receptores guardados para reutilizar en próximas facturas.
model InvoiceRecipient {
  id           String    @id @default(cuid())
  studyId      String
  taxpayerId   String
  name         String
  docType      String // CUIT | DNI | SIN_IDENTIFICAR
  docNumber    String?
  taxCondition String
  createdAt    DateTime  @default(now())
  invoices     Invoice[]

  @@index([taxpayerId])
}

model InvoiceItem {
  id             String  @id @default(cuid())
  invoiceId      String
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position       Int
  description    String
  quantityMilli  Int // cantidad × 1000 (admite 3 decimales)
  unitPriceCents BigInt
  subtotalCents  BigInt

  @@index([invoiceId])
}

// Intento de emisión. La clave única evita emitir dos veces el mismo pedido (doble clic, reintento).
model InvoiceAttempt {
  id             String   @id @default(cuid())
  studyId        String
  taxpayerId     String
  environment    String
  idempotencyKey String
  requestHash    String
  invoiceId      String
  invoice        Invoice  @relation(fields: [invoiceId], references: [id])
  status         String // EN_PROCESO | COMPLETADO | FALLIDO
  resultStatus   String?
  error          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  @@unique([studyId, taxpayerId, environment, idempotencyKey])
}

// Numeración por contribuyente, ambiente, punto de venta y tipo.
model InvoiceSequence {
  id          String @id @default(cuid())
  taxpayerId  String
  environment String
  pointOfSale Int
  invoiceType String
  lastNumber  Int

  @@unique([taxpayerId, environment, pointOfSale, invoiceType])
}

// Cobertura de datos: permite distinguir "cero" de "no hay información".
model DataCoverage {
  id         String   @id @default(cuid())
  taxpayerId String   @unique
  taxpayer   Taxpayer @relation(fields: [taxpayerId], references: [id])
  fromDate   String // primer día con datos completos (YYYY-MM-DD)
  complete   Boolean
  source     String // texto visible: "Cargado por el estudio"
  updatedAt  DateTime @updatedAt
}

model AuditEvent {
  id        String   @id @default(cuid())
  studyId   String
  study     Study    @relation(fields: [studyId], references: [id])
  actorId   String?
  action    String
  entity    String
  entityId  String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([studyId, createdAt])
}

// Solicitud del cliente al estudio. channel = WEB: el campo queda listo para otro canal (por ejemplo WhatsApp), sin construirlo.
model ServiceRequest {
  id             String           @id @default(cuid())
  studyId        String
  taxpayerId     String
  taxpayer       Taxpayer         @relation(fields: [taxpayerId], references: [id])
  createdById    String
  createdBy      User             @relation("RequestCreator", fields: [createdById], references: [id])
  assignedToId   String?
  assignedTo     User?            @relation("RequestAssignee", fields: [assignedToId], references: [id])
  topic          String // FACTURACION | CATEGORIA | DEUDAS | DOCUMENTACION | PAGO | OTRO
  subject        String
  status         String // ABIERTA | EN_CURSO | ESPERANDO_CLIENTE | RESUELTA
  priority       String           @default("NORMAL") // NORMAL | ALTA
  channel        String           @default("WEB")
  obligationId   String? // pago informado por el cliente sobre un vencimiento
  lastActivityAt DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @default(now()) @updatedAt
  messages       RequestMessage[]

  @@index([studyId, assignedToId, status])
  @@index([taxpayerId, lastActivityAt])
}

// Mensaje de una solicitud. INTERNA = nota del estudio: nunca se devuelve al cliente.
model RequestMessage {
  id         String         @id @default(cuid())
  requestId  String
  request    ServiceRequest @relation(fields: [requestId], references: [id])
  authorId   String
  author     User           @relation(fields: [authorId], references: [id])
  body       String
  visibility String // PUBLICA | INTERNA
  channel    String         @default("WEB")
  createdAt  DateTime       @default(now())
  documents  Document[]

  @@index([requestId, createdAt])
}

// Archivo privado. Se guarda fuera de la carpeta pública con un nombre interno aleatorio (storageKey);
// la descarga pasa siempre por la autorización actual. CLIENTE = lo ve el cliente; INTERNO = solo el estudio.
model Document {
  id           String          @id @default(cuid())
  studyId      String
  taxpayerId   String
  taxpayer     Taxpayer        @relation(fields: [taxpayerId], references: [id])
  storageKey   String          @unique
  fileName     String
  mimeType     String // application/pdf | image/png | image/jpeg
  sizeBytes    Int
  sha256       String
  category     String // CONSTANCIA | COMPROBANTE_PAGO | DECLARACION | FACTURA | ADJUNTO | OTRO
  visibility   String // CLIENTE | INTERNO
  note         String?
  uploadedById String
  uploadedBy   User            @relation(fields: [uploadedById], references: [id])
  messageId    String?
  message      RequestMessage? @relation(fields: [messageId], references: [id])
  obligationId String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @default(now()) @updatedAt

  @@index([taxpayerId, createdAt])
  @@index([messageId])
}
