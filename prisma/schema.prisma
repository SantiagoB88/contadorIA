// ContadorSmart · esquema mínimo del Paso 1 (versión simple, SQLite local).
// Convenciones:
//  - Importes en centavos (BigInt). Nunca se suma dinero con coma flotante.
//  - Fechas contables como texto "YYYY-MM-DD" (sin zona horaria). Eventos técnicos en DateTime (UTC).
//  - Los "enums" se guardan como String porque SQLite no los soporta; los valores válidos están en src/lib/constants.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Study {
  id             String          @id @default(cuid())
  name           String
  acceptsSignups Boolean         @default(false) // el registro público crea usuarios en este estudio
  createdAt      DateTime        @default(now())
  users          User[]
  taxpayers      Taxpayer[]
  invoices       Invoice[]
  auditEvents    AuditEvent[]
  accessRequests AccessRequest[]
}

model User {
  id              String           @id @default(cuid())
  studyId         String
  study           Study            @relation(fields: [studyId], references: [id])
  email           String           @unique
  name            String
  phone           String?
  passwordHash    String
  role            String // ADMIN | CLIENTE
  active          Boolean          @default(true)
  emailVerifiedAt DateTime?
  createdAt       DateTime         @default(now())
  sessions        Session[]
  accesses        TaxpayerAccess[]
  authTokens      AuthToken[]
  accessRequests  AccessRequest[]  @relation("RequestUser")

  @@index([studyId])
}

// Tokens de un solo uso (verificación de correo y recuperación). Se guarda solo el hash.
model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // VERIFICAR_CORREO | RESTABLECER_CLAVE
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, type])
}

// Pedido de un usuario para asociarse a un CUIT. Declarar un CUIT no da acceso: lo aprueba el estudio.
model AccessRequest {
  id                String    @id @default(cuid())
  studyId           String
  study             Study     @relation(fields: [studyId], references: [id])
  userId            String
  user              User      @relation("RequestUser", fields: [userId], references: [id])
  cuit              String
  declaredName      String
  declaredActivity  String
  declaredCategory  String?
  declaredStartDate String // YYYY-MM-DD
  status            String // PENDIENTE | APROBADO | RECHAZADO
  reviewNote        String?
  reviewedById      String?
  reviewedAt        DateTime?
  taxpayerId        String?
  createdAt         DateTime  @default(now())

  @@index([studyId, status])
  @@index([userId])
}

// Correo capturado localmente: en DEMO no se envía nada, se guarda acá y se ve en /dev/correos.
model OutboxEmail {
  id        String   @id @default(cuid())
  to        String
  subject   String
  body      String
  createdAt DateTime @default(now())
}

// Marcas de actualización de datos ya aplicadas (ver prisma/upgrade.ts).
model AppMeta {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Taxpayer {
  id           String           @id @default(cuid())
  studyId      String
  study        Study            @relation(fields: [studyId], references: [id])
  cuit         String // normalizado, 11 dígitos sin guiones
  name         String
  activity     String
  regime       String           @default("MONOTRIBUTO")
  categoryCode String? // categoría registrada (la carga el estudio)
  startDate    String // YYYY-MM-DD
  createdAt    DateTime         @default(now())
  accesses     TaxpayerAccess[]
  invoices     Invoice[]
  coverage     DataCoverage?

  @@unique([studyId, cuit])
}

model TaxpayerAccess {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  taxpayerId String
  taxpayer   Taxpayer @relation(fields: [taxpayerId], references: [id])
  status     String // APROBADO | REVOCADO
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@unique([userId, taxpayerId])
}

// Escala de categorías versionada. En esta versión solo hay una escala FICTICIA de prueba.
model TaxScaleVersion {
  id        String             @id @default(cuid())
  name      String
  source    String
  status    String // DEMO | VALIDADA
  validFrom String // YYYY-MM-DD
  validTo   String? // YYYY-MM-DD
  limits    TaxCategoryLimit[]
}

model TaxCategoryLimit {
  id                String          @id @default(cuid())
  scaleVersionId    String
  scaleVersion      TaxScaleVersion @relation(fields: [scaleVersionId], references: [id])
  code              String
  annualLimitCents  BigInt

  @@unique([scaleVersionId, code])
}

// Comprobantes / movimientos de facturación.
model Invoice {
  id                    String            @id @default(cuid())
  studyId               String
  study                 Study             @relation(fields: [studyId], references: [id])
  taxpayerId            String
  taxpayer              Taxpayer          @relation(fields: [taxpayerId], references: [id])
  issueDate             String // YYYY-MM-DD
  recipientName         String
  description           String
  amountCents           BigInt // total; en el facturador lo calcula el servidor desde los ítems
  currency              String            @default("ARS")
  status                String // VERIFICADO | BORRADOR | EN_PROCESO | SIMULADO | RECHAZADO
  source                String // DATOS_FICTICIOS | CARGA_MANUAL | FACTURADOR
  environment           String            @default("DEMO")
  createdById           String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @default(now()) @updatedAt
  // Facturador: fotografía de los datos del receptor al momento del comprobante.
  recipientId           String?
  recipient             InvoiceRecipient? @relation(fields: [recipientId], references: [id])
  recipientDocType      String? // CUIT | DNI | SIN_IDENTIFICAR
  recipientDocNumber    String?
  recipientTaxCondition String? // CONSUMIDOR_FINAL | RESPONSABLE_INSCRIPTO | MONOTRIBUTO | EXENTO
  invoiceType           String? // C (monotributo)
  pointOfSale           Int?
  number                Int? // numeración interna de la simulación, no fiscal
  issuedAt              DateTime?
  rejectionReason       String?
  items                 InvoiceItem[]
  attempts              InvoiceAttempt[]

  @@index([taxpayerId, issueDate])
  @@index([taxpayerId, source, status])
}

// Receptores guardados para reutilizar en próximas facturas.
model InvoiceRecipient {
  id           String    @id @default(cuid())
  studyId      String
  taxpayerId   String
  name         String
  docType      String // CUIT | DNI | SIN_IDENTIFICAR
  docNumber    String?
  taxCondition String
  createdAt    DateTime  @default(now())
  invoices     Invoice[]

  @@index([taxpayerId])
}

model InvoiceItem {
  id             String  @id @default(cuid())
  invoiceId      String
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position       Int
  description    String
  quantityMilli  Int // cantidad × 1000 (admite 3 decimales)
  unitPriceCents BigInt
  subtotalCents  BigInt

  @@index([invoiceId])
}

// Intento de emisión. La clave única evita emitir dos veces el mismo pedido (doble clic, reintento).
model InvoiceAttempt {
  id             String   @id @default(cuid())
  studyId        String
  taxpayerId     String
  environment    String
  idempotencyKey String
  requestHash    String
  invoiceId      String
  invoice        Invoice  @relation(fields: [invoiceId], references: [id])
  status         String // EN_PROCESO | COMPLETADO | FALLIDO
  resultStatus   String?
  error          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  @@unique([studyId, taxpayerId, environment, idempotencyKey])
}

// Numeración por contribuyente, ambiente, punto de venta y tipo.
model InvoiceSequence {
  id          String @id @default(cuid())
  taxpayerId  String
  environment String
  pointOfSale Int
  invoiceType String
  lastNumber  Int

  @@unique([taxpayerId, environment, pointOfSale, invoiceType])
}

// Cobertura de datos: permite distinguir "cero" de "no hay información".
model DataCoverage {
  id         String   @id @default(cuid())
  taxpayerId String   @unique
  taxpayer   Taxpayer @relation(fields: [taxpayerId], references: [id])
  fromDate   String // primer día con datos completos (YYYY-MM-DD)
  complete   Boolean
  source     String // texto visible: "Cargado por el estudio"
  updatedAt  DateTime @updatedAt
}

model AuditEvent {
  id        String   @id @default(cuid())
  studyId   String
  study     Study    @relation(fields: [studyId], references: [id])
  actorId   String?
  action    String
  entity    String
  entityId  String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([studyId, createdAt])
}
