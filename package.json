{
  "name": "contador-smart",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/ensure-db.mjs",
    "dev": "next dev",
    "build": "node scripts/vercel-prepare.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify.mjs",
    "postinstall": "prisma generate",
    "db:setup": "prisma db push && tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts --reset",
    "db:studio": "prisma studio",
    "dev:test": "node scripts/dev-test.mjs",
    "test:e2e": "playwright test",
    "start:railway": "node scripts/railway-start.mjs",
    "start:server": "node scripts/server-start.mjs",
    "ensayo:piloto": "node scripts/ensayo-piloto.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "libphonenumber-js": "1.13.15",
    "next": "15.5.28",
    "nodemailer": "10.3.1",
    "pdf-lib": "1.17.1",
    "prisma": "6.19.3",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3"
  }
}
